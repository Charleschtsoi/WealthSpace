// WealthSpace — personal wealth management schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CASH
  BROKERAGE
  REAL_ESTATE
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BUY
  SELL
}

model Account {
  id          String           @id @default(cuid())
  name        String
  type        AccountType
  balance     Decimal          @db.Decimal(18, 2)
  currency    String           @default("USD")
  lastUpdated DateTime         @default(now())
  createdAt   DateTime         @default(now())
  holdings    AssetHolding[]
  transactions Transaction[]
}

model AssetHolding {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ticker       String
  quantity     Decimal  @db.Decimal(18, 6)
  averagePrice Decimal  @db.Decimal(18, 4)
  currentPrice Decimal  @db.Decimal(18, 4)
  currency     String   @default("USD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([accountId])
  @@index([ticker])
}

model Transaction {
  id          String          @id @default(cuid())
  accountId   String
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Decimal         @db.Decimal(18, 2)
  date        DateTime
  description String?
  createdAt   DateTime        @default(now())

  @@index([accountId])
  @@index([date])
}

model NetWorthSnapshot {
  id               String   @id @default(cuid())
  date             DateTime @unique
  totalAssets      Decimal  @db.Decimal(18, 2)
  totalLiabilities Decimal  @db.Decimal(18, 2) @default(0)
  netWorth         Decimal  @db.Decimal(18, 2)
  createdAt        DateTime @default(now())

  @@index([date])
}
