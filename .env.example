# Optional for MVP — without this, the app uses labeled demo portfolio data.
# Use the dashboard "Start with my data" CTA for an empty personal ledger,
# then set DATABASE_URL to persist spreadsheet edits to Postgres.
# With Postgres: copy to .env, then `npm run db:setup` (db push + idempotent seed).
# Example local URL:
DATABASE_URL="postgresql://wealthspace:wealthspace@localhost:5432/wealthspace?schema=public"

# Optional demo fallbacks — users can also BYOK in Settings
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY=""
