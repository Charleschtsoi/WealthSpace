# Optional for MVP — without this, the app uses demo portfolio placeholders.
# With Postgres: copy to .env, then `npm run db:setup` (db push + idempotent seed).
# Example local URL (user/password/db created for you):
DATABASE_URL="postgresql://wealthspace:wealthspace@localhost:5432/wealthspace?schema=public"

# Optional demo fallbacks — users can also BYOK in Settings
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY=""
